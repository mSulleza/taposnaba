# ---- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# New-style publishable key (sb_publishable_…) — or use the legacy anon key below.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Needed for Admin → Users (create helper accounts) and the daily cron.
# New-style secret key (sb_secret_…) — or the legacy service_role key.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Vercel Cron ------------------------------------------------------------
# Any long random string. Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
