{
  "name": "tapos-na-ba",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:test": "tsx scripts/db-test.ts",
    "typecheck": "tsc --noEmit",
    "db:push": "supabase db push",
    "db:seed": "supabase db query --linked -f supabase/seed.sql",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/database.types.ts",
    "mock:supabase": "node scripts/mock-supabase.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run lint && npm run db:test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.31.0",
    "next": "16.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
